OPENMRS_ATOMFEED_PASSWORD=Admin123
OPENELIS_HOST=openelis
OPENELIS_PORT=8052
OPENELIS_ATOMFEED_USER=atomfeed
OPENELIS_ATOMFEED_PASSWORD=AdminadMIN*

# OpenMRS Environment Variables
